# Copy to .env and fill in. Never commit .env.

# --- Required ---
OPENAI_API_KEY=your-openai-api-key
SECRET_KEY=change-me-long-random-string        # python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-another-random-string # defaults to SECRET_KEY if empty

# --- Admin bootstrap (first run only) ---
# If ADMIN_PASSWORD is empty a random one is generated and printed once to the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Models ---
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Web ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Storage (Docker image sets sensible /data defaults) ---
DATABASE_FILE=rag_chatbot.db
VECTOR_DB_PATH=chroma_db
UPLOAD_FOLDER=documents
